// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "darwin", "darwin-arm64", "linux-arm64-openssl-1.1.x"]
  output        = "../../../../node_modules/prisma_types/products"
}

datasource db {
  provider = "postgresql"
  url      = env("PRODUCTS_DB_URL")
}

enum MusicType {
  TRACK
  ALBUM

  @@map("music_type")
}

enum ComponentLvl {
  TOP
  MIDDLE
  BOTTOM
  ARRANGEMENT

  @@map("component_lvl")
}

enum ComponentType {
  NOTE_ALCOHOL
  NOTE_ETHEREAL
  ALCOHOL
  ETHEREAL

  @@map("component_type")
}

enum Sex {
  MAN
  WOMEN
  UNISEX

  @@map("sex")
}

enum ProductEntity {
  PERFUME

  @@map("product_entity")
}

enum ComponentHistoryType {
  ADD
  CREATE
  SPENT

  @@map("component_history_type")
}

enum PerfumeStatus {
  DRAFT
  PUBLISH

  @@map("perfume_status")
}

enum CollectionStatus {
  DRAFT
  PENDING
  PUBLISH

  @@map("collection_status")
}

model Track {
  id           String  @id @default(uuid()) @db.Uuid
  shortTrackId String  @map("short_track_id") @db.Uuid
  fullTrackId  String? @map("full_track_id") @db.Uuid

  musics Music[]

  @@map("track")
}

model Music {
  id      String    @id @default(uuid()) @db.Uuid
  trackId String?   @map("track_id") @db.Uuid
  name    String    @db.VarChar(255)
  type    MusicType

  track   Track?    @relation(fields: [trackId], references: [id])
  product Product[]

  @@map("music")
}

model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(255)
  description String           @db.Text
  status      CollectionStatus @default(DRAFT)
  imageIds    String[]         @db.Uuid

  items CollectionItem[]

  @@map("collection")
}

model CollectionItem {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String?  @unique @map("product_id") @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  index        Int
  imageIds     String[] @map("image_ids") @db.Uuid

  collection Collection @relation(fields: [collectionId], references: [id])
  product    Product?   @relation(fields: [productId], references: [id])
}

model ComponentHistory {
  id          String               @id @default(uuid()) @db.Uuid
  receiptId   String?              @map("receipt_id") @db.Uuid // чек может быть одинаковым для нескольких компонентов
  createdAt   DateTime             @updatedAt @map("created_id")
  type        ComponentHistoryType @default(CREATE)
  count       Decimal              @default(1)
  componentId String               @map("component_id") @db.Uuid
  component   Component            @relation(fields: [componentId], references: [id])
}

model Provider {
  id      String  @id @default(uuid()) @db.Uuid
  name    String  @db.VarChar(255)
  address String? @db.VarChar(255)
  site    String? @db.VarChar(255)

  components Component[]

  @@map("provider")
}

// при покупки мы ищем название конкретного компонента и провайдера
// если его нет, то мы создаем новый, добавляя в историю CREATE, 
// иначе добавляем к текущему, добавляя в историю ADD
model Component {
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @unique @db.VarChar(255)
  description   String?            @db.Text
  volume        Decimal
  type          ComponentType      @default(ALCOHOL)
  providerId    String             @map("provider_id") @db.Uuid
  provider      Provider           @relation(fields: [providerId], references: [id])
  histories     ComponentHistory[]
  ComponentItem ComponentItem[]

  @@map("component")
}

model ComponentItem {
  id          String       @id @default(uuid()) @db.Uuid
  componentId String       @map("component_id") @db.Uuid
  component   Component    @relation(fields: [componentId], references: [id])
  lvl         ComponentLvl
  volume      Int
  index       Int
  perfumeId   String       @map("perfume_id") @db.Uuid
  perfume     Perfume      @relation(fields: [perfumeId], references: [id])

  @@map("component_item")
}

model Perfume {
  id                String          @id @default(uuid()) @db.Uuid
  authorId          String          @map("author_id") @db.Uuid
  sex               Sex             @default(UNISEX)
  authorDescription String          @map("author_description") @db.Text
  status            PerfumeStatus   @default(DRAFT)
  productItems      ProductItem[]
  componentsItems   ComponentItem[]

  @@map("perfume")
}

model Product {
  id           String  @id @default(uuid()) @db.Uuid
  isCollection Boolean @default(true) @map("is_collection")
  musicId      String  @map("music_id") @db.Uuid
  currentPrice Decimal @map("current_price")
  name         String  @db.VarChar(255)
  description  String  @db.VarChar(255)

  music          Music           @relation(fields: [musicId], references: [id])
  itemId         String          @unique @map("item_id") @db.Uuid
  item           ProductItem     @relation(fields: [itemId], references: [id])
  collectionItem CollectionItem?

  @@map("product")
}

model ProductItem {
  id        String        @id @default(uuid()) @db.Uuid
  entity    ProductEntity @default(PERFUME)
  perfumeId String?       @map("perfume_id") @db.Uuid
  count     Decimal

  product Product?
  perfume Perfume? @relation(fields: [perfumeId], references: [id])

  @@map("product_item")
}
