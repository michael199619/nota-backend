// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "darwin", "darwin-arm64", "linux-arm64-openssl-1.1.x"]
  output        = "../../../../node_modules/prisma_types/emails"
}

datasource db {
  provider = "postgresql"
  url      = env("EMAILS_DB_URL")
}

enum EmailStatus {
  PENDING
  SUCCESS
  REJECT
}

enum SubscriptionType {
  ALL
  IMPORTANT
  NOT
}

model Emails {
  id          String      @id @db.Uuid
  buyerId     String      @db.Uuid
  text        String      @db.Text
  comment     String?
  status      EmailStatus @default(PENDING)
  newletterId String      @db.Uuid
}

model Subscription {
  id   String           @id @db.Uuid
  type SubscriptionType @default(ALL)
}

model Client {
  buyerId        String @id @db.Uuid
  subscriptionId String @db.Uuid
}

model NewsLetterUser {
  buyerId     String @id @db.Uuid
  newLetterId String @db.Uuid
}

model NewLetterId {
  id         String   @id @db.Uuid
  startTime  DateTime
  finishTime DateTime
  isForAll   Boolean  @default(true)
}
