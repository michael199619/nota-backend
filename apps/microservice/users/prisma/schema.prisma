// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "darwin", "darwin-arm64", "linux-arm64-openssl-1.1.x"]
  output        = "../../../../node_modules/prisma_types/users"
}

datasource db {
  provider = "postgresql"
  url      = env("USERS_DB_URL")
}

enum SalaryType {
  SALE_OWN_PRODUCT // зарплата за продажу своего продукта
  SALE_ALL_PRODUCT // зарплата за продажу всей продукции
  FIX // фиксированная зарплата
}

enum SalaryValueType {
  PROCENT
  CURRENCY
}

model Role {
  id   String  @id @db.Uuid
  name String?

  users User[]
}

model Salary {
  userId String @id @db.Uuid
  day    Int?

  type      SalaryType      @default(FIX)
  valueType SalaryValueType @default(CURRENCY)
  value     Float

  user User @relation(fields: [userId], references: [id])
}

model User {
  id       String  @id @db.Uuid
  login    String
  phone    Int
  email    String
  avatarId String? @db.Uuid
  password String
  name     String

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  salary Salary[]
}
