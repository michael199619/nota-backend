// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "darwin", "darwin-arm64", "linux-arm64-openssl-1.1.x"]
  output        = "../../../../node_modules/prisma_types/users"
}

datasource db {
  provider = "postgresql"
  url      = env("USERS_DB_URL")
}

enum SalaryType {
  SALE_OWN_PRODUCT // зарплата за продажу своего продукта
  SALE_ALL_PRODUCT // зарплата за продажу всей продукции
  FIX // фиксированная зарплата

  @@map("salary_type")
}

enum SalaryValueType {
  PROCENT
  CURRENCY

  @@map("salary_value_type")
}

model Role {
  id   String @id @db.Uuid
  name String

  users User[]

  @@map("role")
}

model Salary {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  day    Int?

  type      SalaryType      @default(FIX)
  valueType SalaryValueType @default(CURRENCY) @map("value_type")
  value     Float

  user User @relation(fields: [userId], references: [id])
}

model User {
  id       String  @id @default(uuid()) @db.Uuid
  login    String  @unique
  phone    String
  email    String
  avatarId String? @map("avatar_id") @db.Uuid
  password String
  name     String

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  salaries Salary[]
}
