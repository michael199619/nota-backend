FROM node:18-alpine AS base

WORKDIR /app

# Копируем только package files
COPY package*.json ./
COPY apps/common/package*.json ./apps/common/ 2>/dev/null || true

RUN npm ci && npm cache clean --force

FROM base AS development

COPY apps/common ./apps/common
COPY apps/${SERVICE_NAME} ./apps/${SERVICE_NAME}
COPY nest-cli.json ./
COPY tsconfig*.json ./

RUN npm install -g ts-node

EXPOSE ${PORT:-3000}

# Команда для запуска сервиса
CMD ["sh", "-c", "npm run start:dev:service ${SERVICE_NAME}"]

FROM base AS builder

COPY apps/common ./apps/common
COPY apps/${SERVICE_NAME} ./apps/${SERVICE_NAME}
COPY nest-cli.json ./
COPY tsconfig*.json ./

# Собираем только нужный сервис
RUN npm run build:${SERVICE_NAME}

# Production stage
FROM node:18-alpine AS production

WORKDIR /app

# Создаем пользователя
RUN addgroup -g 1001 -S nodejs && adduser -S nestjs -u 1001

# Копируем package files
COPY package*.json ./

# Устанавливаем только production зависимости
RUN npm ci --only=production && npm cache clean --force

# Копируем собранное приложение
COPY --from=builder --chown=nestjs:nodejs /app/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/apps/common ./apps/common

# Переключаемся на пользователя
USER nestjs

# Открываем порт
EXPOSE ${PORT:-3000}

# Команда по умолчанию
CMD ["node", "dist/apps/${SERVICE_NAME}/main.js"]
