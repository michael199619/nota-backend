{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "nota-schematics",
  "sourceRoot": "apps/api/client/src",
  "monorepo": true,
  "root": "apps/api/client",
  "defaultProject": "admin",
  "compilerOptions": {
    "webpack": true
  },
  "projects": {
    "admin": {
      "type": "application",
      "root": "apps/api/admin",
      "entryFile": "main",
      "sourceRoot": "apps/api/admin/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/admin/tsconfig.app.json"
      }
    },
    "bank": {
      "type": "application",
      "root": "apps/microservice/bank",
      "entryFile": "main",
      "sourceRoot": "apps/microservice/bank/src",
      "compilerOptions": {
        "tsConfigPath": "apps/microservice/bank/tsconfig.app.json"
      }
    },
    "buyers": {
      "type": "application",
      "root": "apps/microservice/buyers",
      "entryFile": "main",
      "sourceRoot": "apps/microservice/buyers/src",
      "compilerOptions": {
        "tsConfigPath": "apps/microservice/buyers/tsconfig.app.json"
      }
    },
    "client": {
      "type": "application",
      "root": "apps/api/client",
      "entryFile": "main",
      "sourceRoot": "apps/api/client/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/client/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "apps/common",
      "entryFile": "index",
      "sourceRoot": "apps/common/src",
      "compilerOptions": {
        "tsConfigPath": "apps/common/tsconfig.lib.json"
      }
    },
    "emails": {
      "type": "application",
      "root": "apps/microservice/emails",
      "entryFile": "main",
      "sourceRoot": "apps/microservice/emails/src",
      "compilerOptions": {
        "tsConfigPath": "apps/microservice/emails/tsconfig.app.json"
      }
    },
    "orders": {
      "type": "application",
      "root": "apps/microservice/orders",
      "entryFile": "main",
      "sourceRoot": "apps/microservice/orders/src",
      "compilerOptions": {
        "tsConfigPath": "apps/microservice/orders/tsconfig.app.json"
      }
    },
    "products": {
      "type": "application",
      "root": "apps/microservice/products",
      "entryFile": "main",
      "sourceRoot": "apps/microservice/products/src",
      "compilerOptions": {
        "tsConfigPath": "apps/microservice/products/tsconfig.app.json"
      }
    },
    "storage": {
      "type": "application",
      "root": "apps/microservice/storage",
      "entryFile": "main",
      "sourceRoot": "apps/microservice/storage/src",
      "compilerOptions": {
        "tsConfigPath": "apps/microservice/storage/tsconfig.app.json"
      }
    },
    "users": {
      "type": "application",
      "root": "apps/microservice/users",
      "entryFile": "main",
      "sourceRoot": "apps/microservice/users/src",
      "compilerOptions": {
        "tsConfigPath": "apps/microservice/users/tsconfig.app.json"
      }
    }
  }
}