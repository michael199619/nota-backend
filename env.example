# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=perfume-platform
KAFKA_GROUP_ID=perfume-group

# Prisma
USERS_DB_URL="postgresql://perfume_user:perfume_password@localhost:5432/perfume_platform?schema=public"
ORDERS_DB_URL="postgresql://perfume_order:perfume_password@localhost:5433/perfume_platform?schema=public"
PRODUCTS_DB_URL="postgresql://perfume_products:perfume_password@localhost:5433/perfume_platform?schema=public"
BANK_DB_URL="postgresql://perfume_bank:perfume_password@localhost:5433/perfume_platform?schema=public"
EMAILS_DB_URL="postgresql://perfume_emails:perfume_password@localhost:5433/perfume_platform?schema=public"
STORAGE_DB_URL="postgresql://perfume_storage:perfume_password@localhost:5433/perfume_platform?schema=public"
BUYERS_DB_URL="postgresql://perfume_buyers:perfume_password@localhost:5433/perfume_platform?schema=public"

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=24h

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Payment
PAYMENT_GATEWAY_URL=https://api.payment-gateway.com
PAYMENT_GATEWAY_KEY=your-payment-key
PAYMENT_GATEWAY_SECRET=your-payment-secret

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=perfume-storage
