
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=perfume-platform
KAFKA_GROUP_ID=perfume-group

# Orders
ORDERS_DB_PORT=5434
ORDERS_DB_NAME=orders
ORDERS_DB_USER=postgres
ORDERS_DB_PASSWORD=postgres
ORDERS_DB_URL="postgresql://${ORDERS_DB_USER}:${ORDERS_DB_PASSWORD}@localhost:${ORDERS_DB_PORT}/${ORDERS_DB_NAME}?schema=public"

# Users
USERS_DB_PORT=5433
USERS_DB_NAME=users
USERS_DB_USER=postgres
USERS_DB_PASSWORD=postgres
USERS_DB_URL="postgresql://${USERS_DB_USER}:${USERS_DB_PASSWORD}@localhost:${USERS_DB_PORT}/${USERS_DB_NAME}?schema=public"

# Products
PRODUCTS_DB_PORT=5435
PRODUCTS_DB_NAME=products
PRODUCTS_DB_USER=postgres
PRODUCTS_DB_PASSWORD=postgres
PRODUCTS_DB_URL="postgresql://${PRODUCTS_DB_USER}:${PRODUCTS_DB_PASSWORD}@localhost:${PRODUCTS_DB_PORT}/${PRODUCTS_DB_NAME}?schema=public"

# Buyers
BUYERS_DB_PORT=5439
BUYERS_DB_NAME=buyers
BUYERS_DB_USER=postgres
BUYERS_DB_PASSWORD=postgres
BUYERS_DB_URL="postgresql://${BUYERS_DB_USER}:${BUYERS_DB_PASSWORD}@localhost:${BUYERS_DB_PORT}/${BUYERS_DB_NAME}?schema=public"

# Emails
EMAILS_DB_PORT=5437
EMAILS_DB_NAME=emails
EMAILS_DB_USER=postgres
EMAILS_DB_PASSWORD=postgres
EMAILS_DB_URL="postgresql://${EMAILS_DB_USER}:${EMAILS_DB_PASSWORD}@localhost:${EMAILS_DB_PORT}/${EMAILS_DB_NAME}?schema=public"

# Storage
STORAGE_DB_PORT=5436
STORAGE_DB_NAME=storage
STORAGE_DB_USER=postgres
STORAGE_DB_PASSWORD=postgres
STORAGE_DB_URL="postgresql://${STORAGE_DB_USER}:${STORAGE_DB_PASSWORD}@localhost:${STORAGE_DB_PORT}/${STORAGE_DB_NAME}?schema=public"

# Storage
BANK_DB_PORT=5438
BANK_DB_NAME=storage
BANK_DB_USER=postgres
BANK_DB_PASSWORD=postgres
BANK_DB_URL="postgresql://${BANK_DB_USER}:${BANK_DB_PASSWORD}@localhost:${BANK_DB_PORT}/${BANK_DB_NAME}?schema=public"


# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=24h

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Payment
PAYMENT_GATEWAY_URL=https://api.payment-gateway.com
PAYMENT_GATEWAY_KEY=your-payment-key
PAYMENT_GATEWAY_SECRET=your-payment-secret

# Storage 
STORAGE_TYPE=local
STORAGE_PATH=./uploads
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=perfume-storage
